import React from 'react';
import { Dimensions, StyleSheet, Text, View } from 'react-native';
import Animated, {
  Extrapolation,
  interpolate,
  useAnimatedScrollHandler,
  useAnimatedStyle,
  useSharedValue,
} from 'react-native-reanimated';

const { height: SCREEN_HEIGHT } = Dimensions.get('window');

const CARD_HEIGHT = SCREEN_HEIGHT * 0.65;
const SPACING = 16;
const ITEM_FULL_SIZE = CARD_HEIGHT + SPACING;
const SNAP_OFFSET = (SCREEN_HEIGHT - ITEM_FULL_SIZE) / 2;

const DATA = [
  {
    id: '1',
    title: 'Quantum Computing Breakthroughs',
    category: 'Physics',
    content: 'Exploring how topological qubits are reducing quantum decoherence in modern scale architectures.',
    color: '#1E293B',
  },
  {
    id: '2',
    title: 'Generative Search Architectures',
    category: 'Artificial Intelligence',
    content: 'Deep dive into retrieval-augmented generation and latent space indexing for sub-second responses.',
    color: '#0F172A',
  },
  {
    id: '3',
    title: 'Solid-State Battery Tech',
    category: 'Energy',
    content: 'How ceramic electrolyte interfaces are pushing energy density beyond 500 Wh/kg limits.',
    color: '#18181B',
  },
  {
    id: '4',
    title: 'Neural Interfaces & BCI',
    category: 'Neuroscience',
    content: 'High-density micro-electrode arrays enabling bidirectional motor cortex decoding.',
    color: '#111827',
  },
];

function CardItem({ item, index, scrollY }) {
  const animatedStyle = useAnimatedStyle(() => {
    const position = (scrollY.value - index * ITEM_FULL_SIZE) / ITEM_FULL_SIZE;

    const scale = interpolate(
      position,
      [-1, 0, 1],
      [0.9, 1, 0.9],
      Extrapolation.CLAMP
    );

    const opacity = interpolate(
      position,
      [-1, -0.5, 0, 0.5, 1],
      [0.4, 0.8, 1, 0.8, 0.4],
      Extrapolation.CLAMP
    );

    const translateY = interpolate(
      position,
      [-1, 0, 1],
      [-20, 0, 20],
      Extrapolation.CLAMP
    );

    return {
      opacity,
      transform: [{ scale }, { translateY }],
    };
  });

  return (
    <Animated.View style={[styles.card, { backgroundColor: item.color }, animatedStyle]}>
      <Text style={styles.badge}>{item.category.toUpperCase()}</Text>
      <Text style={styles.cardTitle}>{item.title}</Text>
      <Text style={styles.cardBody}>{item.content}</Text>
    </Animated.View>
  );
}

export default function PerplexityVerticalList() {
  const scrollY = useSharedValue(0);

  const scrollHandler = useAnimatedScrollHandler({
    onScroll: (event) => {
      scrollY.value = event.contentOffset.y;
    },
  });

  return (
    <View style={styles.container}>
      <Animated.FlatList
        data={DATA}
        keyExtractor={(item) => item.id}
        onScroll={scrollHandler}
        scrollEventThrottle={16}
        snapToInterval={ITEM_FULL_SIZE}
        decelerationRate="fast"
        showsVerticalScrollIndicator={false}
        contentContainerStyle={{
          paddingTop: SNAP_OFFSET,
          paddingBottom: SNAP_OFFSET,
        }}
        renderItem={({ item, index }) => (
          <CardItem item={item} index={index} scrollY={scrollY} />
        )}
      />
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#050505',
  },
  card: {
    height: CARD_HEIGHT,
    marginHorizontal: 20,
    marginBottom: SPACING,
    borderRadius: 24,
    padding: 24,
    justifyContent: 'space-between',
    borderWidth: 1,
    borderColor: 'rgba(255, 255, 255, 0.08)',
  },
  badge: {
    color: '#22D3EE',
    fontSize: 12,
    fontWeight: '700',
    letterSpacing: 1.5,
  },
  cardTitle: {
    color: '#F8FAFC',
    fontSize: 28,
    fontWeight: '700',
    lineHeight: 34,
  },
  cardBody: {
    color: '#94A3B8',
    fontSize: 15,

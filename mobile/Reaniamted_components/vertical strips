export default function FlutedGlassScreen() {
  const image = useImage(require('./flower.jpg'));

  if (!image) return null;

  return (
    <View style={styles.container}>
      <Canvas style={styles.canvas}>
        <Fill>
          <Shader
            source={REED_GLASS_SHADER}
            uniforms={{
              resolution: [SCREEN_WIDTH, SCREEN_HEIGHT],
              numFlutes: 18.0,            // Number of vertical glass bars
              refractionStrength: 0.85,    // Depth of lens distortion
            }}
          >
            <ImageShader
              image={image}
              fit="cover"
              rect={{ x: 0, y: 0, width: SCREEN_WIDTH, height: SCREEN_HEIGHT }}
            />
          </Shader>
        </Fill>
      </Canvas>
    </View>
  );
}


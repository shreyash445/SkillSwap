import React, { useState } from 'react';
import { Dimensions, Pressable, StyleSheet, View } from 'react-native';
import { MotiView } from 'moti';
import { Bell, Compass, Home, User } from 'lucide-react-native';

const { width: SCREEN_WIDTH } = Dimensions.get('window');

const TABS = [
  { key: 'home', icon: Home, label: 'Home' },
  { key: 'explore', icon: Compass, label: 'Explore' },
  { key: 'notifications', icon: Bell, label: 'Alerts' },
  { key: 'profile', icon: User, label: 'Profile' },
];

const TAB_BAR_WIDTH = SCREEN_WIDTH - 48;
const TAB_WIDTH = (TAB_BAR_WIDTH - 12) / TABS.length; // Accounting for container padding

export default function AnimatedTabBar() {
  const [activeIndex, setActiveIndex] = useState(0);

  return (
    <View style={styles.container}>
      <View style={styles.tabBarContainer}>
        {/* Sliding Active Indicator Pill */}
        <MotiView
          animate={{
            translateX: activeIndex * TAB_WIDTH,
          }}
          transition={{
            type: 'spring',
            damping: 18,
            stiffness: 180,
          }}
          style={[styles.activeIndicator, { width: TAB_WIDTH }]}
        />

        {/* Tab Items */}
        {TABS.map((tab, index) => {
          const Icon = tab.icon;
          const isActive = activeIndex === index;

          return (
            <Pressable
              key={tab.key}
              onPress={() => setActiveIndex(index)}
              style={styles.tabButton}
            >
              <MotiView
                animate={{
                  scale: isActive ? 1.15 : 1,
                  translateY: isActive ? -2 : 0,
                }}
                transition={{
                  type: 'spring',
                  damping: 14,
                  stiffness: 200,
                }}
                style={styles.iconContainer}
              >
                <Icon
                  size={22}
                  color={isActive ? '#FFFFFF' : 'rgba(255, 255, 255, 0.45)'}
                  strokeWidth={isActive ? 2.5 : 2}
                />
              </MotiView>
            </Pressable>
          );
        })}
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    backgroundColor: '#090A0F',
    justifyContent: 'flex-end',
    alignItems: 'center',
    paddingBottom: 40,
  },
  tabBarContainer: {
    flexDirection: 'row',
    width: TAB_BAR_WIDTH,
    height: 64,
    backgroundColor: '#16181F',
    borderRadius: 32,
    padding: 6,
    alignItems: 'center',
    position: 'relative',
    borderWidth: 1,
    borderColor: 'rgba(255, 255, 255, 0.08)',
    shadowColor: '#000',
    shadowOffset: { width: 0, height: 10 },
    shadowOpacity: 0.35,
    shadowRadius: 20,
    elevation: 10,
  },
  activeIndicator: {
    position: 'absolute',
    left: 6,
    height: 52,
    backgroundColor: '#6366F1',
    borderRadius: 26,
  },
  tabButton: {
    flex: 1,
    height: '100%',
    justifyContent: 'center',
    alignItems: 'center',
    zIndex: 2,
  },
  iconContainer: {
    justifyContent: 'center',
    alignItems: 'center',
  },
});